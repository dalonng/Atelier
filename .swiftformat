# SwiftFormat configuration
# Generated by AppScaffold

# Swift version
--swiftversion 6.4

# Indentation
--indent 2
--indentcase false
--ifdef outdent

# Line wrapping
--maxwidth 120
--wraparguments before-first
--wrapcollections before-first
--wrapparameters before-first
--wrapconditions after-first
--wraptypealiases before-first
--enable wrapIfStatementBodies
--enable wrapGuardStatementBodies
--enable wrapIfExpressionBodies

# Spacing
--trimwhitespace always
--voidtype void
--enable blankLineAfterImports
--enable blankLinesAfterGuardStatements
--line-between-guards false

# Organization
--importgrouping alpha
--trailingcommas always

# Project style notes:
# - SwiftFormat 0.61.1 can enforce one blank line after imports, but not exactly two.
# - SwiftFormat can enforce a blank line after guard statements, but not after every
#   return/continue/break in arbitrary control-flow branches.
# - SwiftFormat cannot require comment-only logical separators for other code groups.
#
# Those semantic spacing/comment rules need SwiftLint custom rules or review.

# Disable rules that conflict with project style
--disable redundantSelf

# Exclude generated/vendor code
--exclude DerivedData,fastlane/DerivedData,Packages/ZVendors,Packages/Y-AppMacro,.build,Derived
